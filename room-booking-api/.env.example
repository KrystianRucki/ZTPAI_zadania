NODE_ENV=production
PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=roombooking

DATABASE_URL=postgresql://postgres:change-this-password@localhost:5432/roombooking

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m

REPOSITORY_MODE=knex
DISABLE_APP_OVERLAP_CHECK=false